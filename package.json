{
  "name": "astro-ai-i18n",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "An Astro site that translates itself with AI Glot: static pages, a Markdown CMS, and a translation workflow an agent can run.",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "i18n:status": "node scripts/i18n.mjs status",
    "i18n:translate": "node scripts/i18n.mjs translate",
    "i18n:bless": "node scripts/i18n.mjs bless",
    "i18n:check": "node scripts/i18n.mjs check",
    "test": "node --test test/*.test.mjs && npm run build"
  },
  "dependencies": {
    "astro": "7.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "5.9.3"
  }
}
