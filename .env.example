# A workspace API key from https://app.ai-glot.com/developer
#
# Only needed to RUN a translation. Cloning, building and serving this site
# needs nothing: every translation it ships is committed as a plain file.
#
# The CLI reads this variable before its keychain, so exporting it here is
# enough for `npm run i18n:translate`.
AIGLOT_API_KEY=

# "cli" (default) shells out to the aiglot CLI. "api" talks to the REST API
# with fetch and no dependency. Both do the same four calls; see AGENTS.md.
AIGLOT_TRANSPORT=cli

# "lite" is one credit per three words and is the right default for copy you
# review in a diff. "standard" is one per word.
AIGLOT_QUALITY=lite
