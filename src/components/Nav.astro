---
import { localizedPath, type Locale } from '../i18n/config';
import { ui } from '../i18n/ui';
import LanguagePicker from './LanguagePicker.astro';

interface Props {
  locale: Locale;
  /** The English path of the current page, e.g. `/blog/quiet-tools`. */
  path: string;
  availableIn?: Locale[];
}

const { locale, path, availableIn } = Astro.props;
const copy = ui(locale);

/* Hrefs are written once, in English, and localized here. A link inside a
   German page that points at `/about` drops the reader out of German
   mid-sentence, which is the defect nothing else catches: the page renders and
   the link works, it is just in the wrong language. */
const links = [
  { href: '/about', label: copy.nav.about },
  { href: '/blog', label: copy.nav.blog },
];
---

<header>
  <div class="page bar">
    <a class="brand" href={localizedPath(locale, '/')}>{copy.site.name}</a>

    <nav aria-label={copy.nav.home}>
      {
        links.map((link) => (
          <a
            href={localizedPath(locale, link.href)}
            aria-current={path.startsWith(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <LanguagePicker locale={locale} path={path} availableIn={availableIn} />
  </div>
</header>

<style>
  header {
    border-bottom: 1px solid var(--line);
    position: sticky;
    top: 0;
    background: var(--paper);
    z-index: 10;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 4rem;
  }

  .brand {
    font-weight: 600;
    letter-spacing: -0.02em;
    text-decoration: none;
    margin-right: auto;
  }

  nav {
    display: flex;
    gap: 1.25rem;
    font-size: 0.9375rem;
  }

  nav a { text-decoration: none; color: var(--muted); }
  nav a:hover { color: var(--ink); }
  nav a[aria-current] { color: var(--ink); }

  @media (max-width: 34rem) {
    .bar { gap: 1rem; }
    nav { gap: 0.9rem; }
  }
</style>
