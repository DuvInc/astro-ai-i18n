---
/**
 * The site's entire illustration budget: four inline SVGs, no files, no colour.
 *
 * They exist so a page has something to look at while it is being designed,
 * and so a translated page is measured against a real layout rather than an
 * empty column. Replace them with your own artwork; nothing else reads them.
 */
interface Props {
  name?: 'grid' | 'arc' | 'stack' | 'split';
  size?: number;
  class?: string;
}

const { name = 'grid', size = 96, class: className } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 96 96"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  aria-hidden="true"
  class={className}
>
  {
    name === 'grid' && (
      <>
        <rect x="8" y="8" width="34" height="34" />
        <rect x="54" y="8" width="34" height="34" />
        <rect x="8" y="54" width="34" height="34" />
        <rect x="54" y="54" width="34" height="34" fill="currentColor" />
      </>
    )
  }
  {
    name === 'arc' && (
      <>
        <circle cx="48" cy="48" r="40" />
        {/* The left half, filled: an arc from the top of the circle to the
            bottom, the long way round, closed along the diameter. */}
        <path d="M48 8a40 40 0 0 0 0 80z" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    name === 'stack' && (
      <>
        <rect x="8" y="14" width="80" height="18" />
        <rect x="8" y="39" width="80" height="18" fill="currentColor" />
        <rect x="8" y="64" width="80" height="18" />
      </>
    )
  }
  {
    name === 'split' && (
      <>
        <rect x="8" y="8" width="80" height="80" />
        <path d="M48 8v80" />
        <path d="M8 48h40" />
      </>
    )
  }
</svg>
