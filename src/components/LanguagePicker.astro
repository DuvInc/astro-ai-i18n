---
import { localeConfig, localePrefix, locales, type Locale } from '../i18n/config';
import { ui } from '../i18n/ui';

/**
 * The picker, as a `<details>` element: it opens, closes and is keyboard
 * operable with no JavaScript at all, which matters on a site whose whole
 * output is static HTML.
 *
 * `path` is the English path of the page the reader is on, so switching
 * language keeps them on the same page instead of dropping them at the home
 * page of another language — the single most common defect in a hand-rolled
 * picker.
 */
interface Props {
  locale: Locale;
  path: string;
  /** Locales that actually have this page. Others are marked, never hidden. */
  availableIn?: Locale[];
}

const { locale, path, availableIn } = Astro.props;
const copy = ui(locale);
const clean = path === '/' ? '' : path.replace(/\/$/, '');
---

<details class="picker">
  <summary aria-label={copy.picker.label}>
    <span>{localeConfig[locale].short}</span>
    <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M1 3l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
  </summary>
  <ul>
    {
      locales.map((code) => {
        const untranslated = availableIn !== undefined && !availableIn.includes(code);
        return (
          <li>
            <a
              href={`${localePrefix(code)}${clean}` || '/'}
              hreflang={localeConfig[code].language}
              lang={localeConfig[code].language}
              aria-current={code === locale ? 'true' : undefined}
            >
              {localeConfig[code].name}
              {/* An honest picker says which languages have this page. Hiding
                  the entry would be worse: the reader concludes the language
                  does not exist at all. */}
              {untranslated && <em aria-hidden="true">EN</em>}
            </a>
          </li>
        );
      })
    }
  </ul>
</details>

<style>
  .picker {
    position: relative;
    font-size: 0.875rem;
  }

  summary {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  summary::-webkit-details-marker { display: none; }

  details[open] summary { border-color: var(--ink); }

  ul {
    position: absolute;
    right: 0;
    top: calc(100% + 0.35rem);
    z-index: 5;
    min-width: 11rem;
    margin: 0;
    padding: 0.25rem;
    list-style: none;
    background: var(--paper);
    border: 1px solid var(--ink);
    border-radius: var(--radius);
  }

  a {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.4rem 0.6rem;
    text-decoration: none;
    border-radius: var(--radius);
  }

  a:hover { background: var(--wash); }
  a[aria-current] { font-weight: 600; }

  em {
    font-style: normal;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 0 0.25rem;
  }
</style>
