---
/**
 * The banner a fallback page carries.
 *
 * It exists so the reader is not left wondering whether the site is broken or
 * their language setting is. Saying "not translated yet" costs one line and
 * turns a confusing page into an honest one.
 */
interface Props {
  text: string;
}

const { text } = Astro.props;
---

<p class="notice" role="note">{text}</p>
