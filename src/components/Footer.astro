---
import { localeConfig, localePrefix, locales, localizedPath, type Locale } from '../i18n/config';
import { ui } from '../i18n/ui';

interface Props {
  locale: Locale;
  path: string;
}

const { locale, path } = Astro.props;
const copy = ui(locale);
const clean = path === '/' ? '' : path.replace(/\/$/, '');
const year = new Date().getFullYear();
---

<footer>
  <div class="page cols">
    <div>
      <strong>{copy.site.name}</strong>
      <p class="meta">{copy.site.tagline}</p>
    </div>

    <div>
      <p class="eyebrow">{copy.footer.sections}</p>
      <ul>
        <li><a href={localizedPath(locale, '/')}>{copy.nav.home}</a></li>
        <li><a href={localizedPath(locale, '/about')}>{copy.nav.about}</a></li>
        <li><a href={localizedPath(locale, '/blog')}>{copy.nav.blog}</a></li>
      </ul>
    </div>

    <div>
      <p class="eyebrow">{copy.footer.languages}</p>
      <ul>
        {
          locales.map((code) => (
            <li>
              <a href={`${localePrefix(code)}${clean}` || '/'} hreflang={localeConfig[code].language}>
                {localeConfig[code].name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="page bottom meta">
    <span>&copy; {year} {copy.site.name}. {copy.footer.rights}</span>
    <span>{copy.footer.builtWith}</span>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--line);
    margin-top: 4rem;
    padding-block: 3rem 2rem;
  }

  .cols {
    display: grid;
    gap: 2rem;
    grid-template-columns: 2fr 1fr 1fr;
  }

  @media (max-width: 40rem) {
    .cols { grid-template-columns: 1fr; }
  }

  ul { list-style: none; margin: 0; padding: 0; font-size: 0.9375rem; }
  li { margin-bottom: 0.35rem; }
  a { text-decoration: none; color: var(--muted); }
  a:hover { color: var(--ink); text-decoration: underline; }

  .bottom {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }
</style>
