---
import type { GetStaticPaths } from 'astro';

import Base from '../../layouts/Base.astro';
import Glyph from '../../components/Glyph.astro';
import Notice from '../../components/Notice.astro';
import { defaultLocale, localeConfig, localizedPath, locales, type Locale } from '../../i18n/config';
import { hasSection, interpolate, ui } from '../../i18n/ui';

/**
 * One file, every locale.
 *
 * `[...locale]` is a rest parameter, so the same route answers for `/` (the
 * parameter is undefined) and for `/fr`. Four route files rather than four
 * times four near-identical ones, which is the shape this repository exists to
 * avoid: a duplicated route is a route that gets fixed in three places out of
 * four.
 */
export const getStaticPaths = (() =>
  locales.map((locale) => ({
    params: { locale: locale === defaultLocale ? undefined : locale },
    props: { locale },
  }))) satisfies GetStaticPaths;

const { locale } = Astro.props as { locale: Locale };
const copy = ui(locale);
const translated = hasSection(locale, 'home');
const availableIn = locales.filter((code) => hasSection(code, 'home'));
---

<Base
  locale={locale}
  path="/"
  title={copy.home.meta.title}
  description={copy.home.meta.description}
  translated={translated}
  availableIn={availableIn}
>
  <section class="section page">
    {
      !translated && (
        <Notice text={interpolate(copy.notice.untranslated, { language: localeConfig[locale].name })} />
      )
    }

    <div class="hero">
      <div>
        <p class="eyebrow">{copy.home.hero.eyebrow}</p>
        <h1>{copy.home.hero.title}</h1>
        <p class="lead measure">{copy.home.hero.body}</p>
        <p class="actions">
          <a class="button" href={localizedPath(locale, '/blog')}>{copy.home.hero.primary}</a>
          <a class="button button--ghost" href={localizedPath(locale, '/about')}>
            {copy.home.hero.secondary}
          </a>
        </p>
      </div>
      <Glyph name="arc" size={200} />
    </div>
  </section>

  <section class="section page">
    <h2>{copy.home.features.title}</h2>
    <p class="lead measure">{copy.home.features.body}</p>
    <div class="grid" style="margin-top:2.5rem">
      {
        copy.home.features.items.map((item, index) => (
          <article class="card">
            <Glyph name={(['grid', 'stack', 'split'] as const)[index] ?? 'grid'} size={40} />
            <h3 style="margin-top:1rem">{item.title}</h3>
            <p class="meta">{item.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section page">
    <h2>{copy.home.numbers.title}</h2>
    <div class="grid" style="margin-top:2rem">
      {
        copy.home.numbers.items.map((item) => (
          <p class="stat">
            <b>{item.value}</b>
            <span>{item.label}</span>
          </p>
        ))
      }
    </div>
  </section>

  <section class="section page">
    <div class="measure">
      <h2>{copy.home.cta.title}</h2>
      <p class="lead">{copy.home.cta.body}</p>
      <p><a class="button" href={localizedPath(locale, '/about')}>{copy.home.cta.action}</a></p>
    </div>
  </section>
</Base>

<style>
  .hero {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
  }

  .hero :global(svg) { flex: none; opacity: 0.9; }

  .actions { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 2rem; }

  @media (max-width: 46rem) {
    .hero :global(svg) { display: none; }
  }
</style>
