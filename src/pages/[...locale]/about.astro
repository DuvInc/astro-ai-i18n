---
import type { GetStaticPaths } from 'astro';

import Base from '../../layouts/Base.astro';
import Redirect from '../../layouts/Redirect.astro';
import Glyph from '../../components/Glyph.astro';
import Notice from '../../components/Notice.astro';
import {
  defaultLocale,
  localeConfig,
  localizedPath,
  locales,
  untranslated,
  type Locale,
} from '../../i18n/config';
import { hasSection, interpolate, ui } from '../../i18n/ui';

export const getStaticPaths = (() =>
  locales.map((locale) => ({
    params: { locale: locale === defaultLocale ? undefined : locale },
    props: { locale },
  }))) satisfies GetStaticPaths;

const { locale } = Astro.props as { locale: Locale };
const copy = ui(locale);
const translated = hasSection(locale, 'about');
const availableIn = locales.filter((code) => hasSection(code, 'about'));

/* The two modes, in one place per route. `fallback` renders below with a
   notice; `redirect` never renders the page at all. */
const leaving = !translated && untranslated === 'redirect';
---

{
  leaving ? (
    <Redirect locale={locale} to={localizedPath(defaultLocale, '/about')} />
  ) : (
    <Base
      locale={locale}
      path="/about"
      title={copy.about.meta.title}
      description={copy.about.meta.description}
      translated={translated}
      availableIn={availableIn}
    >
      <section class="section page">
        {!translated && (
          <Notice text={interpolate(copy.notice.untranslated, { language: localeConfig[locale].name })} />
        )}

        <p class="eyebrow">{copy.nav.about}</p>
        <h1>{copy.about.title}</h1>
        <p class="lead measure" style="margin-top:1.5rem">
          {copy.about.lead}
        </p>
      </section>

      <section class="section page">
        <div class="grid">
          {copy.about.sections.map((item) => (
            <article>
              <h2 style="font-size:1.125rem">{item.title}</h2>
              <p class="meta" style="margin-top:0.5rem">
                {item.body}
              </p>
            </article>
          ))}
        </div>
      </section>

      <section class="section page">
        <h2>{copy.about.ships.title}</h2>
        <div class="grid" style="margin-top:2rem">
          {copy.about.ships.items.map((item, index) => (
            <article class="card">
              <Glyph name={(['grid', 'arc', 'stack', 'split'] as const)[index % 4]} size={36} />
              <h3 style="margin-top:1rem">{item.title}</h3>
              <p class="meta">{item.body}</p>
            </article>
          ))}
        </div>
      </section>
    </Base>
  )
}
