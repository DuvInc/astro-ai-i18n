---
import { localeConfig, type Locale } from '../i18n/config';

/**
 * What `untranslated: 'redirect'` renders: a page whose only job is to leave.
 *
 * A static build has no server to answer with a 301, so this is a meta refresh
 * plus a canonical, which every crawler and every browser honours. On a real
 * host, move it up a layer — a Cloudflare / Netlify / Vercel redirect rule, or
 * Astro's own `redirects` config — and delete this file. A rule answers before
 * any HTML is sent, which is faster and does not flash a blank page.
 */
interface Props {
  to: string;
  locale: Locale;
}

const { to, locale } = Astro.props;
const site = Astro.site ?? new URL('http://localhost:4321');
const target = new URL(to, site).href;
---

<!doctype html>
<html lang={localeConfig[locale].language}>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <link rel="canonical" href={target} />
    <meta name="robots" content="noindex, follow" />
    <title>Redirecting</title>
  </head>
  <body>
    <p>This page is not translated yet. <a href={to}>Continue in English</a>.</p>
  </body>
</html>
